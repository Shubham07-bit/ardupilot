# Default parameters for ANTHENA-H743 PRO board

# Enable IMU BMMI088 on SPI
INS_GYR_CAL=0
INS_GYR2_ID=2
INS_ACC2_ID=2
INS_ENABLE_MASK=3

# Barometer MS5611 on I2C
BRD_IMU_TARGTEMP=45

# Compass configuration
COMPASS_EXTERN=0
COMPASS_ORIENT=2
COMPASS_USE=1

# Default to using only GPS1
GPS_TYPE2=0

# Configure serial ports
SERIAL1_PROTOCOL=2
SERIAL2_PROTOCOL=2
SERIAL3_PROTOCOL=5
SERIAL4_PROTOCOL=-1
SERIAL5_PROTOCOL=-1

# Set battery monitoring
BATT_MONITOR=4
BATT_VOLT_PIN=14
BATT_CURR_PIN=15
BATT_VOLT_MULT=18.0
BATT_AMP_PERVLT=24.0

# Default to Copter LED scheme
NTF_LED_TYPES=231

# Default frame configuration
FRAME_CLASS=1
FRAME_TYPE=1